{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera photographs meals so Life can estimate calories."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера фотографирует еду, чтобы Life оценил калории."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Life reads your sleep from Health to show it and to coach your evenings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Life читает твой сон из «Здоровья», чтобы показывать его и помогать с вечерами."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used to dictate quick entries such as expenses."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон нужен, чтобы диктовать быстрые записи, например расходы."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition turns your dictated entries into text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи превращает диктовку в текст."
          }
        }
      }
    }
  },
  "version": "1.0"
}
